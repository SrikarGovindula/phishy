# Phishy / ThreatLens Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server Ports
BACKEND_PORT=8080
FRONTEND_PORT=3001
HOST=0.0.0.0

# Debug Mode
# IMPORTANT: Set to False for production!
# When True: Enables API docs, wildcard CORS, verbose logging
# When False: Disables API docs, restricted CORS, production logging
DEBUG=True

# ============================================
# FIREBASE & FIRESTORE DATABASE CONFIGURATION
# ============================================

# Firebase Project ID (from Firebase Console)
FIREBASE_PROJECT_ID=phishy-security

# Path to service account key JSON file (download from Firebase Console -> Project Settings -> Service accounts)
# Leave empty to use Application Default Credentials or the local persistence engine
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase Realtime Database URL (optional, if using Realtime DB alongside Firestore)
FIREBASE_DATABASE_URL=

# Firestore Emulator (optional, for local emulator testing: e.g. localhost:8085)
# FIRESTORE_EMULATOR_HOST=localhost:8085

# ============================================
# SECURITY & JWT CONFIGURATION
# ============================================

# Secret key used for signing JWT tokens (Change to a strong random key in production!)
JWT_SECRET=your-production-jwt-secret-key-threatlens-2024

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT Expiration in minutes (default: 1440 = 24 hours)
JWT_EXPIRATION_MINUTES=1440

# CORS Allowed Origins (Production only)
# For production deployments, specify allowed origins as comma-separated list
# Leave empty for development (uses wildcard when DEBUG=True)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=

# ============================================
# EXTERNAL API KEYS (Optional)
# ============================================

# Google Safe Browsing API
# Get your API key from: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFEBROWSING_API_KEY=your-google-safe-browsing-key

# URLScan.io API
# Get your API key from: https://urlscan.io/user/signup
URLSCAN_IO_API_KEY=your-urlscan-api-key

# VirusTotal API
# Get your API key from: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# AbuseIPDB API
# Get your API key from: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your-abuseipdb-api-key

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Base URL for tracking links (used by email generator)
BASE_URL=http://localhost:8080

# ============================================
# PRODUCTION SECURITY CHECKLIST
# ============================================
# Before deploying to production:
# [ ] Set DEBUG=False
# [ ] Configure FIREBASE_PROJECT_ID and FIREBASE_SERVICE_ACCOUNT_KEY
# [ ] Set a strong JWT_SECRET
# [ ] Configure ALLOWED_ORIGINS with specific domains
# [ ] Use HTTPS (required for Chrome extension)
# [ ] Implement rate limiting (nginx/Cloudflare)
# [ ] Review SECURITY.md for full checklist
# [ ] Never commit .env or service-account.json with real keys!